{
  "version": 2,
  "dark": {
    "hue": {
      "accent": "$hue.red",
      "interactive": "$hue.blue",
      "red": {
        "100": "#F5E0E4",
        "200": "#D8959F",
        "300": "#C0737E",
        "400": "#A95E69",
        "500": "#924A55",
        "600": "#783842",
        "700": "#5F2B34",
        "800": "#472027",
        "900": "#30161B"
      },
      "green": {
        "100": "#E8EBD6",
        "200": "#9AA86B",
        "300": "#87945E",
        "400": "#74804F",
        "500": "#626D43",
        "600": "#515A38",
        "700": "#40472D",
        "800": "#303522",
        "900": "#202419"
      },
      "blue": {
        "100": "#DFE9EF",
        "200": "#7FA3B8",
        "300": "#6B93A9",
        "400": "#5A8199",
        "500": "#4B6F86",
        "600": "#3D5D72",
        "700": "#314A5C",
        "800": "#263946",
        "900": "#1B2833"
      },
      "purple": {
        "100": "#EEDFE7",
        "200": "#BE8AA2",
        "300": "#AC7B94",
        "400": "#996987",
        "500": "#865775",
        "600": "#734665",
        "700": "#5C3753",
        "800": "#452942",
        "900": "#301D2E"
      }
    },
    "categorical": ["red", "purple", "blue", "green"],
    "footer": {
      "categorical": ["red", "purple", "blue", "green"]
    },
    "text": {
      "default": "#E6DFD3",
      "subdued": "#A89B85",
      "action": {
        "primary": {
          "default": "#D8959F",
          "$focused": "#F5EFE3",
          "$pressed": "#EAB3BA",
          "$disabled": "#6E6455"
        },
        "secondary": {
          "default": "#A89B85",
          "$focused": "#E6DFD3",
          "$pressed": "#C9BCA6",
          "$disabled": "#6E6455"
        },
        "destructive": {
          "default": "#D86A76",
          "$focused": "#F5EFE3",
          "$pressed": "#E58A94",
          "$disabled": "#6E6455"
        }
      },
      "formfield": {
        "default": "#E6DFD3",
        "$hovered": "#EFE7D6",
        "$focused": "#F5EFE3",
        "$pressed": "#E6DFD3",
        "$disabled": "#7A6E5C",
        "$selected": "#D8959F"
      },
      "status": {
        "running": "#7FA3B8",
        "question": "#BE8AA2",
        "permission": "#D6B787",
        "unread": "#D8959F"
      },
      "feedback": {
        "error": {
          "default": "#E07884",
          "subdued": "#A85D67"
        },
        "warning": {
          "default": "#D6B787",
          "subdued": "#A68F62"
        },
        "success": {
          "default": "#9AA86B",
          "subdued": "#77854F"
        },
        "info": {
          "default": "#7FA3B8",
          "subdued": "#5F7E8C"
        }
      }
    },
    "background": {
      "default": "#1B1917",
      "surface": {
        "offset": "#1F1D1A",
        "overlay": "#1F1D1A"
      },
      "action": {
        "primary": {
          "default": "#3A3226",
          "$focused": "#6A5951",
          "$pressed": "#54463A",
          "$disabled": "#242019",
          "$selected": "#6A5951"
        },
        "secondary": {
          "default": "#242019",
          "$focused": "#33291F",
          "$pressed": "#2A251E",
          "$disabled": "#1B1917"
        },
        "destructive": {
          "default": "#3A2226",
          "$focused": "#5A2E33",
          "$pressed": "#4A272C",
          "$disabled": "#242019"
        }
      },
      "formfield": {
        "default": "#1F1D1A",
        "$hovered": "#24211C",
        "$focused": "#2A251F",
        "$pressed": "#2A251F",
        "$disabled": "#1B1917",
        "$selected": "#33291F"
      },
      "feedback": {
        "error": {
          "default": "#2E1D21"
        },
        "warning": {
          "default": "#2B2316"
        },
        "success": {
          "default": "#20261A"
        },
        "info": {
          "default": "#1B262C"
        }
      },
      "@context:elevated": {
        "default": "#2E2822"
      },
      "@context:overlay": {
        "default": "#2E2822"
      }
    },
    "border": {
      "default": "#8A7D68"
    },
    "scrollbar": {
      "default": "#8A7D68"
    },
    "syntax": {
      "comment": "#7A6E5C",
      "keyword": "#D8959F",
      "function": "#7FA3B8",
      "variable": "#E6DFD3",
      "string": "#9AA86B",
      "number": "#BE8AA2",
      "type": "#D6B787",
      "operator": "#86B5AC",
      "punctuation": "#A89B85"
    },
    "diff": {
      "text": {
        "added": "#9AA86B",
        "removed": "#D8959F"
      },
      "background": {
        "added": "#444732",
        "removed": "#564142",
        "context": "#1F1D1A"
      },
      "highlight": {
        "added": "#B3C084",
        "removed": "#EAB3BA"
      },
      "lineNumber": {
        "text": "#A89B85",
        "background": {
          "added": "#444732",
          "removed": "#564142"
        }
      }
    },
    "markdown": {
      "heading": "#D8959F",
      "link": "#7FA3B8",
      "code": "#D6B787",
      "blockQuote": "#A89B85",
      "emphasis": "#BE8AA2",
      "strong": "#EAB3BA"
    }
  }
}